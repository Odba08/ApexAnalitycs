generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Equipo {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  liga      String
  elo       Float    @default(1500.0)
  form5     Int      @default(0)
  form3     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AlertaValor {
  id                 Int      @id @default(autoincrement())
  deporte            String   @default("FUTBOL")
  partido            String
  liga               String
  mercadoRecomendado String
  cuotaCasa          Float
  probabilidadIA     Float
  ventajaPorcentaje  Float
  stakeRecomendado   Float    @default(1.0)
  estado             String   @default("PENDIENTE")
  resultadoFinal     String?
  ejecutada          Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model PilotoF1 {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique
  escuderia          String
  elo                Float    @default(1500.0)
  puntosMundial      Float    @default(0.0)
  victorias          Int      @default(0)
  poles              Int      @default(0)
  podios             Int      @default(0)
  podiosConsecutivos Int      @default(0)
  fp1Pos             Int      @default(10)
  fp2Pos             Int      @default(10)
  rachaReciente      String   @default("")
  form5              Float    @default(50.0)
  updatedAt          DateTime @updatedAt
}

model EscuderiaF1 {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  elo           Float    @default(1500.0)
  puntosMundial Float    @default(0.0)
  victorias     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model GranPremioF1 {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique
  circuito   String
  fecha      String
  fase       String   @default("Prácticas Libres FP1/FP2")
  poleName   String?
  winnerName String?
  updatedAt  DateTime @updatedAt
}

model PeleadorUFC {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  categoria String   @default("Unknown")
  reachCm   Float    @default(0.0)
  age       Int      @default(30)
  sigStrMin Float    @default(0.0)
  avgTd15m  Float    @default(0.0)
  subAvg15m Float    @default(0.0)
  tdDefPct  Float    @default(0.0)
  strDefPct Float    @default(0.0)
  elo       Float    @default(1500.0)
  victorias Int      @default(0)
  derrotas  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model EventoUFC {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  fecha     String
  sede      String?
  estado    String   @default("PROGRAMADO")
  updatedAt DateTime @updatedAt
}
